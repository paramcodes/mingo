{
	"name": "mingo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"typecheck:fast": "tsrs -p tsconfig.json --noEmit",
		"test": "bun test",
		"test:browser:lightpanda": "agent-browser --engine lightpanda open http://localhost:3000 && agent-browser snapshot",
		"test:browser:chrome": "agent-browser --engine chrome open http://localhost:3000 && agent-browser errors",
		"generate:state-chart": "bun run scripts/generate-state-chart.ts",
		"capture:media": "bun run scripts/capture-media.ts",
		"verify": "bun run lint && bun run typecheck && bun test && bun run build"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"next": "^16.4.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"lefthook": "^2.2.2",
		"pele": "^1.9.0",
		"postcss": "^8.5.31",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
